# ==============================================================================
# THINDI (ತಿಂಡಿ) Environment Configuration
# ==============================================================================

# Public Site URL (Used for Canonical URLs, Open Graph, Sitemap & Robots)
NEXT_PUBLIC_SITE_URL=https://thindi-psi.vercel.app

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Optional for Demo / Local Development)
# If omitted or empty, the application automatically runs in demo mode.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Shiprocket Courier & Tracking Integration (Optional for Demo / Local Development)
# If omitted, simulated mock tracking milestones are served.
# ------------------------------------------------------------------------------
SHIPROCKET_API_TOKEN=
SHIPROCKET_WEBHOOK_TOKEN=

# ------------------------------------------------------------------------------
# Cryptographic Session Secrets
# Used for HMAC-SHA256 signing of staff sessions, OTP verification, and order tokens.
# ------------------------------------------------------------------------------
ADMIN_SESSION_SECRET=thindi_hassan_admin_secure_key_2026
ORDER_SESSION_SECRET=thindi_secure_session_secret_hassan_2026
